# Copy to server/.env and adjust. Never commit server/.env.

PORT=3000

# Development + demo database (docker compose service "postgres", port 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rehabquest"

# At least 16 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="8h"

# Comma-separated list of allowed web origins.
CORS_ORIGIN="http://localhost:5173"

# Timezone for new accounts when the browser does not send one.
DEFAULT_TIMEZONE="Asia/Jerusalem"

# Tests use their own database (docker compose service "postgres-test", port 5433).
# It must be local and named exactly rehabquest_test; see scripts/test-db.ts.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rehabquest_test"

# Password reset: no email service is integrated. For local development only,
# "true" returns the reset token in the API response. Ignored when NODE_ENV=production.
DEV_EXPOSE_RESET_TOKENS="false"

# Login/registration attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=30

# --- Therapist summary drafts -------------------------------------------------
# Without these, the app uses the clearly labelled rule-based summary.
# Only enable with synthetic/demo data unless you have authorization and a data
# processing agreement for sending health information to the provider.
AI_SUMMARY_PROVIDER="none"          # "anthropic" to enable
# ANTHROPIC_API_KEY="sk-ant-..."    # server-side only; never exposed to the browser
AI_SUMMARY_MODEL="claude-opus-5-5"
AI_SUMMARY_TIMEOUT_MS=20000
AI_SUMMARY_MODEL_HOURLY_LIMIT=10    # model calls per therapist per hour
AI_SUMMARY_TOTAL_HOURLY_LIMIT=60    # all summary requests per therapist per hour (then HTTP 429)
