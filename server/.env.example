# Copy to server/.env and adjust. Never commit server/.env.

PORT=3000

# Development + demo database (docker compose service "postgres", port 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rehabquest"

# At least 16 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN="8h"

# Comma-separated list of allowed web origins.
CORS_ORIGIN="http://localhost:5173"

# Timezone for new accounts when the browser does not send one.
DEFAULT_TIMEZONE="Asia/Jerusalem"

# Tests use their own database (docker compose service "postgres-test", port 5433).
# It must be local and named exactly rehabquest_test; see scripts/test-db.ts.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rehabquest_test"

# --- Email (password reset) ---------------------------------------------------
# "log" prints emails to the server log (development only). "resend" sends them
# through https://resend.com (free tier available). Production refuses to start
# without a real provider. The sender must be on a domain verified with the provider.
EMAIL_PROVIDER="log"
# RESEND_API_KEY="re_..."
EMAIL_FROM="RehabQuest <no-reply@your-domain.example>"
# EMAIL_REPLY_TO="clinic@your-domain.example"

# Public URL of the web app, used for links in emails (no trailing slash).
APP_BASE_URL="http://localhost:5173"

# Password reset in local development without email: "true" also returns the reset
# token in the API response. Ignored when NODE_ENV=production.
DEV_EXPOSE_RESET_TOKENS="false"

# --- Production hosting -------------------------------------------------------
# When set, the API serves the built web app from this folder and the API moves to /api
# (same origin; CORS_ORIGIN is then not needed). The Dockerfile sets this.
# CLIENT_DIST_DIR="../client/dist"
# Run reminders/outbox delivery inside the API process instead of a separate "npm run worker".
# WORKER_IN_PROCESS="true"
# WORKER_INTERVAL_MS=30000
# Behind a proxy or PaaS, trust X-Forwarded-* headers for client IPs (default: on in production).
# TRUST_PROXY="true"

# 3D exercise demonstrations: patients only see ones a physiotherapist approved.
# "true" also shows unreviewed ones, labelled as a preview. Default: on in development,
# off when NODE_ENV=production. See docs/EXERCISE_DEMOS.md.
# EXERCISE_DEMO_PREVIEW="false"

# Login/registration attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=30

# --- Therapist summary drafts -------------------------------------------------
# Without these, the app uses the clearly labelled rule-based summary.
# Only enable with synthetic/demo data unless you have authorization and a data
# processing agreement for sending health information to the provider.
AI_SUMMARY_PROVIDER="none"          # "anthropic" to enable
# ANTHROPIC_API_KEY="sk-ant-..."    # server-side only; never exposed to the browser
AI_SUMMARY_MODEL="claude-opus-5-5"
AI_SUMMARY_TIMEOUT_MS=20000
AI_SUMMARY_MODEL_HOURLY_LIMIT=10    # model calls per therapist per hour
AI_SUMMARY_TOTAL_HOURLY_LIMIT=60    # all summary requests per therapist per hour (then HTTP 429)
